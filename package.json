{
  "name": "betway-automation-v2",
  "version": "1.0.0",
  "description": "Betway Playwright Automation Framework — shared-core rewrite (ZA pilot)",
  "main": "index.js",
  "scripts": {
    "test:playwright": "playwright test --config=playwright.ZA.config.ts",
    "allure:generate": "allure generate src/regions/ZA/reports/allure-results --clean -o src/regions/ZA/reports/allure-report",
    "test:with-allure": "npm run test:playwright && npm run allure:generate",
    "bi:daily": "playwright test --config=playwright.influencer.config.ts --grep daily",
    "bi:payout": "playwright test --config=playwright.influencer.config.ts --grep payout",
    "bi:daily:all": "node scripts/run-influencer.mjs daily",
    "bi:payout:all": "node scripts/run-influencer.mjs payout"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.9.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
